<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:lang="clr-namespace:sail4oxygen.Resources.Languages"
             x:Class="sail4oxygen.Views.AboutPage"
             Title="{x:Static lang:lang.AboutPageTitle}"
             Shell.BackgroundColor="{AppThemeBinding Light={StaticResource Tertiary}, Dark={StaticResource Tertiary}}"
             >

    <Shell.TitleView>
        <HorizontalStackLayout
            HorizontalOptions="End">
            <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center">
                <Image
                    Source="s4ologospindrift.png"
                    HeightRequest="45"
                    Margin="10"
                    VerticalOptions="Center"
                    HorizontalOptions="End"
                    Aspect="AspectFit" />
                <Label 
                    Text="sail4oxygen" 
                    VerticalOptions="End"
                    FontSize="21"
                    Margin="4"/>
            </HorizontalStackLayout>        </HorizontalStackLayout>
    </Shell.TitleView>

    
    
    <ScrollView>
        <VerticalStackLayout>

            <Label
                Text="{Binding AboutText}"
                TextType="Html"
                Margin="12"
                VerticalOptions="EndAndExpand" 
                HorizontalOptions="EndAndExpand" />

            <Button
                Margin="8"
                Text="{x:Static lang:lang.AboutPageReadMore}"
                Clicked="s4oweb_Clicked"
                HorizontalOptions="CenterAndExpand"
                />

            <Label
                Text="{Binding PrivacyText}"
                TextType="Html"
                Margin="12"
                VerticalOptions="EndAndExpand" 
                HorizontalOptions="EndAndExpand" />

            <Frame Margin="12,0"
                   BackgroundColor="{AppThemeBinding Light={StaticResource White}, Dark={StaticResource White}}">
                <Grid RowDefinitions="500,160" ColumnDefinitions="*,100"
                        Margin="10"
                        HorizontalOptions="Center">

                    <Image
                        Grid.Column="0" Grid.Row="0" Grid.ColumnSpan="2"
                        Source="s4ologos.png"
                        Aspect="AspectFit"
                    />

                    <Label
                        Grid.Row="1" Grid.Column="0"
                        Text="{Binding DeveloperText}"
                        TextColor="{StaticResource BrandDarkType}"
                        TextType="Html"
                        Margin="12"
                        FontSize="Micro"
                        VerticalOptions="EndAndExpand" 
                        HorizontalOptions="EndAndExpand" />

                    <Button
                        Grid.Row="1" Grid.Column="1"
                        BackgroundColor="{StaticResource BrandNeonSoft}"
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        FontSize="Micro"
                        Text="{x:Static lang:lang.DeveloperPageButtonText}"
                        Clicked="Github_Clicked"
                        HorizontalOptions="CenterAndExpand"
                        />
                </Grid>
            </Frame>

            <Button
                Margin="8,24,24,8"
                Text="{x:Static lang:lang.OpenSettingsPage}"
                x:Name="settings"
                Clicked="settings_Clicked"
                HorizontalOptions="CenterAndExpand"
                />
            
        </VerticalStackLayout>
        </ScrollView>
</ContentPage>
