<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:sail4oxygen"
             xmlns:models="clr-namespace:sail4oxygen.Models"
             xmlns:lang="clr-namespace:sail4oxygen.Resources.Languages"
             xmlns:mct="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             xmlns:components="clr-namespace:sail4oxygen.Views.Components"
             x:Class="sail4oxygen.Views.MainPage"
             NavigationPage.HasNavigationBar="False"
             Title="{x:Static lang:lang.MainPageTitle}"
             Shell.BackgroundColor="{AppThemeBinding Light={StaticResource BrandDeep}, Dark={StaticResource Tertiary}}"
             >
    
    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" HorizontalOptions="Fill">
            
            <Button
                Grid.Column="1"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandDeep}, Dark={StaticResource BrandSpindrift}}"
                TextColor="{AppThemeBinding Light={StaticResource BrandSpindrift}, Dark={StaticResource BrandDarkType}}"
                Text="&#x24D8;"
                FontSize="Title"
                Padding="0,0,0,0"
                Margin="12,12,12,6"
                HorizontalOptions="End"
                Clicked="About_Clicked"
            />
            <HorizontalStackLayout Grid.Column="0" HorizontalOptions="Start" VerticalOptions="Center">
            <Image
                Source="s4ologospindrift.png"
                HeightRequest="45"
                Margin="10"
                VerticalOptions="Center"
                HorizontalOptions="End"
                Aspect="AspectFit" />
            <Label 
                Text="sail4oxygen" 
                VerticalOptions="End"
                FontSize="21"
                Margin="4"/>
            </HorizontalStackLayout>
        </Grid>
    </Shell.TitleView>
    
    <ContentPage.Resources>
        <Style x:Key="InvalidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource s4ored}, Dark={StaticResource brightred}}" />
        </Style>
        <Style x:Key="ValidEntryStyle" TargetType="Entry">
            <Setter Property="TextColor" Value="{AppThemeBinding Light={StaticResource Black}, Dark={StaticResource White}}" />
        </Style>
        <models:ConverterHelper x:Key="ConverterHelper" />
    </ContentPage.Resources>
    
    <ScrollView>
        <VerticalStackLayout
            >
            <Label Grid.Column="0" Grid.Row="0"
                   TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandSpindrift}}"
                   Margin="24,24,0,0"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Start"
                   Text="{x:Static lang:lang.MainPageIntro}"
                   FontSize="Medium" />
            
            <mct:Expander IsExpanded="{Binding IsLearnMoreExpanded}">
                <mct:Expander.Header>
                    <Label Grid.Column="0" Grid.Row="0"
                    TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandSpindrift}}"
                    Margin="24,6,24,8"
                    TextType="Html"
                    HorizontalOptions="End"
                    HorizontalTextAlignment="Start"
                    Text="{Binding LearnMoreHeaderText}"
                    FontSize="Small" />    
                </mct:Expander.Header>
                <VerticalStackLayout
                    Background="{AppThemeBinding Light={StaticResource BrandSpindriftBrush}, Dark={StaticResource BrandSpindrift}}"
                    Padding="0,12">
                    <Label
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        Margin="24,8,24,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Start"
                        TextType="Html"
                        Text="{x:Static lang:lang.MainPageIntro2}"
                        FontSize="Small" />

                    <Label
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        Margin="24,8,24,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Start"
                        TextType="Html"
                        Text="{x:Static lang:lang.MainPageIntro3}"
                        FontSize="Small" />
                    <Grid ColumnDefinitions="*,120" RowDefinitions="*">
                    <Label
                        Grid.Row="0" Grid.Column="0"
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        Margin="24,8,24,0"
                        HorizontalOptions="Center"
                        HorizontalTextAlignment="Start"
                        TextType="Html"
                        Text="{x:Static lang:lang.MainPageIntro4}"
                        FontSize="Micro" />
                    <Button
                        Grid.Row="0" Grid.Column="1"
                        Text="{x:Static lang:lang.OpenManualPdf}"
                        FontSize="Micro"
                        Padding="3,3,3,3"
                        BorderColor="{AppThemeBinding Light={StaticResource BrandDeep}, Dark={StaticResource BrandDeep}}"
                        BorderWidth="1"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandNeonFull}, Dark={StaticResource  BrandNeonSoft}}"
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        Margin="6,6,12,12"
                        x:Name="GetPdfManualButton"
                        Clicked="GetPdfManualButton_Clicked"
                        HorizontalOptions="Center" />
                    </Grid>
                </VerticalStackLayout>
            </mct:Expander>
            
            <components:ValidatedTextEntry
                LabelText="{x:Static lang:lang.BoatName}"
                Placeholder="Name"
                PlaceholderColor="{x:StaticResource Gray300}"
                Text="{Binding BoatName, Mode=TwoWay}"
                IsValid="{Binding NameIsValid, Mode=TwoWay}"
                ValidationMessage="{Binding BoatnameValidationMessage}"
                RegexPattern="^[\wøæåØÆÅäöüÄÖÜ0-9\s\-+]*$" />

            <Label
                Margin="24,6"
                FontAttributes="Bold"
                Text="{x:Static lang:lang.Position}" />

            <HorizontalStackLayout
                VerticalOptions="Center"
                HorizontalOptions="Center"
                x:Name="CoordinateEditor"
                >
                <VerticalStackLayout>
                <Label
                    TextType="Html"
                    Text="{x:Static lang:lang.MainPageLatitudeTitle}"
                    FontSize="Micro"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray300}}"
                    VerticalOptions="CenterAndExpand"/>
                <Entry
                    x:Name="LatitudeEntry"
                    Placeholder="{x:Static lang:lang.MainPageLatitudePlaceholder}"
                    Text="{Binding MyLocation.Latitude , Mode=TwoWay, StringFormat='{0:00.00000}', Converter={StaticResource ConverterHelper}}"
                    TextChanged="LatitudeEntry_TextChanged"
                    FontSize="Small"
                    VerticalOptions="CenterAndExpand">
                    <Entry.Behaviors>
                        <mct:TextValidationBehavior 
                            BindingContext="{Binding Source={x:Reference LatitudeEntry}, Path=BindingContext}"
                            InvalidStyle="{StaticResource InvalidEntryStyle}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
                            IsValid="{Binding LatitudeIsValid, Mode=TwoWay}"
                            Flags="ValidateOnValueChanged"
                            RegexPattern="^-?\d+(?:[\,\.]\d+)?$"/>
                    </Entry.Behaviors>
                </Entry>
                <Label
                    TextType="Html"
                    Text="{x:Static lang:lang.MainPageLongitudeTitle}"
                    FontSize="Micro"
                    TextColor="{AppThemeBinding Light={StaticResource Gray900}, Dark={StaticResource Gray300}}"
                    VerticalOptions="CenterAndExpand"/>
                <Entry
                    x:Name="LongitudeEntry"
                    Placeholder="{x:Static lang:lang.MainPageLongitudePlaceholder}"
                    Text="{Binding MyLocation.Longitude, Mode=TwoWay, StringFormat='{0:000.00000}', Converter={StaticResource ConverterHelper}}"
                    TextChanged="LongitudeEntry_TextChanged"
                    FontSize="Small"
                    VerticalOptions="CenterAndExpand">
                    <Entry.Behaviors>
                        <mct:TextValidationBehavior 
                            BindingContext="{Binding Source={x:Reference LongitudeEntry}, Path=BindingContext}"
                            InvalidStyle="{StaticResource InvalidEntryStyle}"
                            IsValid="{Binding LongitudeIsValid, Mode=TwoWay}"
                            ValidStyle="{StaticResource ValidEntryStyle}"
                            Flags="ValidateOnValueChanged"
                            RegexPattern="^-?\d+(?:[\,\.]\d+)?$"
                            />
                    </Entry.Behaviors>
                    
                </Entry>
                </VerticalStackLayout>

                <VerticalStackLayout Spacing="8" Margin="6,12,6,12">
                    <Button
                        Text="{x:Static lang:lang.MainPageGPSReload}"
                        Padding="8,8,8,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandNeonFull}, Dark={StaticResource BrandNeonSoft}}"
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        SemanticProperties.Hint="{x:Static lang:lang.MainPageGPSReloadHint}"
                        Clicked="OnGPSReload_Clicked"
                        HorizontalOptions="Center" />
                    <Button
                        Text="{x:Static lang:lang.CoordinateCalculatorOpen}"
                        Padding="8,8,8,8"
                        BackgroundColor="{AppThemeBinding Light={StaticResource BrandNeonFull}, Dark={StaticResource BrandNeonSoft}}"
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                        Clicked="OpenCoordinateCalculator_Clicked"
                        HorizontalOptions="Center" />
                </VerticalStackLayout>
            </HorizontalStackLayout>
                
            <Label
                Margin="24,6"
                FontAttributes="Bold"
                Text="{x:Static lang:lang.Data}" />

            <Grid RowDefinitions="*" ColumnDefinitions="*,45">
                <Label
                    Grid.Row="0" Grid.Column="0"
                    TextColor="{AppThemeBinding Light={StaticResource Gray500}, Dark={StaticResource Gray300}}"
                    Margin="45,25,45,11"
                    HorizontalOptions="Start"
                    HorizontalTextAlignment="Start"
                    Text="{Binding FileName}"
                    FontSize="Micro" />

                <Button
                    Grid.Row="0" Grid.Column="1"
                    Text="&#x24E7;"
                    Padding="0,10,10,10"
                       BackgroundColor="{AppThemeBinding Light={StaticResource BrandNeonFull}, Dark={StaticResource BrandNeonSoft}}"
                        TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                    Margin="15,12,0,0"
                    SemanticProperties.Hint="{x:Static lang:lang.MainPageFileRemoveHint}"
                    Clicked="OnFileRemove_Clicked"
                    HorizontalOptions="End"
                    IsVisible="{Binding FileRemoveButtonVisible}"/>
            </Grid>
            
            <Button
                Text="{Binding SendButtonText}"
                Padding="50,25,50,25"
                BackgroundColor="{AppThemeBinding Light={StaticResource BrandNeonFull}, Dark={StaticResource BrandNeonSoft}}"
                TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                Margin="0,8,0,20"
                SemanticProperties.Hint="{x:Static lang:lang.MainPageSendButtonHint}"
                Clicked="OnCounterClicked"
                HorizontalOptions="Center" />

            <BoxView
                HeightRequest="1"
                Margin="8,12,8,24"
                Color="{AppThemeBinding Light={StaticResource BrandSpindrift}, Dark={StaticResource BrandSpindrift}}"
                />

            <VerticalStackLayout
                VerticalOptions="FillAndExpand">
                <Label
                    Text="Project News"
                    SemanticProperties.HeadingLevel="Level3"
                    FontSize="18"
                    HorizontalOptions="Center" />
                
                <ListView
                    x:Name="NewsListView"
                    ItemsSource="{Binding News.FirstArticles}"
                    ItemTapped="NewsListView_ItemTapped"
                    ItemSelected="NewsListView_ItemSelected"
                    VerticalOptions="FillAndExpand"
                    HasUnevenRows="True"
                    Margin="0,0,0,0"
                    SeparatorVisibility="None"
                    SelectionMode="None"
                    >
                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <ViewCell>
                                <Frame Margin="5,5"
                                       BackgroundColor="{AppThemeBinding Light={StaticResource BrandSpindrift}, Dark={StaticResource BrandSpindrift}}">
                                <Grid ColumnDefinitions="110,*" RowDefinitions="*">
                                    <VerticalStackLayout Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="1" >
                                        <Image
                                            x:Name="RssImage"
                                            Source="{Binding FeaturedImageSource}"
                                            HeightRequest="100"
                                            WidthRequest="100"
                                            Aspect="AspectFill"
                                            
                                            />
                                        <Label
                                            Text="{Binding RelativeDateTime}"
                                            Margin="0,0,12,0"
                                            LineBreakMode="WordWrap"
                                            HorizontalTextAlignment="End"
                                            FontSize="Micro"
                                            FontFamily="IBMPlexMono"
                                            TextType="Html"
                                            TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                                            />
                                    </VerticalStackLayout>


                                    <VerticalStackLayout Grid.Column="1" Grid.Row="0">
                                        <Label
                                            Text="{Binding Headline}"
                                            Margin="12,0,12,12"
                                            LineBreakMode="WordWrap"
                                            TextType="Html"
                                            FontSize="Medium"
                                            TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                                            />

                                        <Label
                                            Text="{Binding TheAbstract}"
                                            LineBreakMode="WordWrap"
                                            Margin="12,0"
                                            FontSize="Small"
                                            TextType="Html"
                                            TextColor="{AppThemeBinding Light={StaticResource BrandDarkType}, Dark={StaticResource BrandDarkType}}"
                                            />
                                   </VerticalStackLayout>
                                </Grid>
                                </Frame>
                            </ViewCell>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </VerticalStackLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>



